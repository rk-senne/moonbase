  "hooks": {
    "agentSpawn": [
      {
        "command": "echo \"Branch: $(git branch --show-current 2>/dev/null)\" && echo \"---\" && git diff --stat 2>/dev/null | tail -10",
        "timeout_ms": 5000
      }
