  ],
  "allowedTools": [
    "read",
    "shell",
    "grep",
    "glob",
    "code",
    "knowledge"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": ["mvn test", "mvn clean package", "npm test", "npm run build", "npm run lint", "python -m pytest", "cargo test", "cargo build", "go test ./...", "go build ./...", "make test", "make build", "git diff", "git diff --stat", "git status", "git log --oneline -10"],
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": ["numbuh-2", "numbuh-3", "numbuh-5", "numbuh-274", "numbuh-362", "numbuh-0"],
      "trustedAgents": ["numbuh-3", "numbuh-5"]
    }
  },
  "resources": [
    "file://Profile.md",
    "file://../../doctrine/MoonbaseEngineeringDoctrine.md",
    "file://../../doctrine/AgentOperatingProtocol.md",
    "file://../../doctrine/MissionControlDoctrine.md",
    "file://../../mission-system/AgentHandoffContract.md",
    "file://../../mission-system/StopConditions.md",
    "file://../../mission-system/EvidenceLedger.md",
    "file://../../mission-system/AssumptionRegister.md",
    "file://../../doctrine/TestingDoctrine.md"
